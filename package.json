{
  "name": "atrover-backend",
  "version": "1.0.0",
  "description": "Real-time rover control server with video/audio streaming",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "docs": "asyncapi generate fromTemplate asyncapi.yaml @asyncapi/html-template -o docs",
    "docs:validate": "asyncapi validate asyncapi.yaml"
  },
  "dependencies": {
    "ioredis": "^5.3.2",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
